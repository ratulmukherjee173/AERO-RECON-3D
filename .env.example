# ============================================
# AERO RECON-3D — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# ── Frontend (Vite) ──────────────────────────
# The URL where the FastAPI backend is running.
# Local development: http://127.0.0.1:8000
# Production (Render): https://your-app.onrender.com
VITE_BACKEND_URL=http://127.0.0.1:8000

# ── Backend (FastAPI) ────────────────────────
# Comma-separated list of allowed frontend origins for CORS.
# Local development includes Vite dev server and preview server.
# Production: set to your Vercel domain, e.g. https://aero-recon-3d.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

# JWT secret for authentication tokens.
# MUST be changed to a strong random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
AERORECON_JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# Port for the backend server (Render provides this automatically).
PORT=8000
